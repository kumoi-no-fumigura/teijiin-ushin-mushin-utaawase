   ],
   "text": "右有心無心歌合推長曆延喜十六年也",
   "poems": [],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "殿上人ども心ある心なきえりいてんといふとある比七月七日",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "年〓とにこりすや有らん織女の逢ひて戀しき別れのみする",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "思ひやる心の空にしらるれはたなはたつめのわかれ悲しき",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "あかすして別れにしかは天河戀しきせのみおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "棚機の我にあふよのしのゝめの見えぬはかりそ霧はふらまし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "逢事をまつと歎きし時よりも織女つめは今や侘らん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "なかき世につくすともなく織女の戀は空にやつもりたるらん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "あひ見てもあはてもなけく織女のいつか心ののとけかるらむ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あはすして思ひしよりも七夕のあかす別れて後そ侘しき",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "逢みてそいと〓戀しき棚機の慰むはかりあらぬ世なれは",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "年とにあかぬ別れはたなはたのあらぬ人さへ歎くへら也",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あふ計嬉しき事はなけれとも別れて後そ侘しかりける",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "稀に逢て何わかるらん彥星の後に侘しとしらすや有らん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "別れての後や侘しき織女のあふこはるけきとを思へは",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "別れては戀しき物を彥星の昨日けふこそ思ひやらるれ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "あひ見むと思ひしよりも別れての後そ侘しき戀まさりける",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あかてゆく彥星なれは年をへて忘れさりける嬉しけもなし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "天河わたりて後そ七夕のふかき心も思ひしるらん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "逢夜なき織女なれは今はとて歸りて後にまとはれし哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "あかなくに別れにしかは七夕のかはきし袖は今やぬるらん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "織女の思ひせむ空もおもほえし別れて後の心まとひに",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "棚機のあかてわかれし戀をこそ空にみちぬといふへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "とことはにおもほゆる哉彦星のこりす別れて戀渡るらん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "年每にひとせをわたる天河かゝるにかけを見つゝ別れし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "あか月のおきうかりしを天河戀渡るへき物をおもはゝ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "天河年をわたりてたなはたのあかぬ戀する比にも有哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "年〓とにあかぬわかれの織女は命なかくも世にへぬるかな",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
